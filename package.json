{
  "name": "obsidian-opds",
  "version": "1.0.0",
  "description": "Obsidian plugin for connecting to OPDS services to browse and download books",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:obsidian": "npm run build && obsidian plugin:reload id=obsidian-opds && ./tests/obsidian-test.sh",
    "lint": "eslint src --ext ts",
    "format": "prettier --write src/**/*.ts",
    "clean": "rm -f main.js main.js.map && rm -rf .obsidian/plugins/obsidian-opds",
    "clean:vault": "[ -z \"$OBSIDIAN_VAULT\" ] || rm -rf \"$OBSIDIAN_VAULT/.obsidian/plugins/obsidian-opds\"",
    "clean:all": "npm run clean && npm run clean:vault"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "opds",
    "books",
    "ebooks"
  ],
  "author": "hawsers",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.12.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.28.0",
    "obsidian": "^1.5.0",
    "typescript": "^5.3.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "fast-xml-parser": "^4.3.0"
  }
}
